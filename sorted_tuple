### 3. Python Implementation

#Here is the Python implementation applying `UnifiedCryptoEngine` #(`unified_crypto_engine-v2.py`) to map finite power sets to curve points, #verify subset union additivity, and execute Cantor's diagonal #construction:

```python
import importlib.util
import random

# Load the UnifiedCryptoEngine module
spec = importlib.util.spec_from_file_location(
    "unified_crypto_engine_v2",
    "/workspace/artifacts/unified_crypto_engine-v2.py",
)
engine_mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(engine_mod)

engine = engine_mod.UnifiedCryptoEngine()


# --- 1. Subset <-> Scalar Mappings ---
def subset_to_scalar(subset_indices: set) -> int:
    """Converts a subset S \subseteq {0, ..., 255} into a 256-bit scalar integer."""
    s = 0
    for idx in subset_indices:
        s |= 1 << idx
    return s


def scalar_to_subset(s: int) -> set:
    """Converts a 256-bit scalar integer back to a subset S."""
    return {i for i in range(256) if (s >> i) & 1}


# --- 2. Disjoint Union Curve Homomorphism ---
S1 = {0, 3, 8, 254}
S2 = {1, 5, 12, 200}

s1 = subset_to_scalar(S1)
s2 = subset_to_scalar(S2)

# Map subsets S1 and S2 to Projective Curve Points
P1 = engine.scalar_mult_projective(s1, engine.B_proj)
P2 = engine.scalar_mult_projective(s2, engine.B_proj)

# Disjoint Union Point: P(S1 u S2) == P(S1) + P(S2)
s_union = subset_to_scalar(S1 | S2)
P_union = engine.scalar_mult_projective(s_union, engine.B_proj)
P_sum = engine.add_projective(P1, P2)

print("S1:", S1)
print("S2:", S2)
print(
    "Disjoint Union Point Match:",
    engine.to_affine(P_union) == engine.to_affine(P_sum),
)


# --- 3. Cantor's Diagonal Construction over 256 Subsets ---
random.seed(42)
matrix_256 = [random.getrandbits(256) for _ in range(256)]

# Diagonal Flip: d_i = 1 - M_{i,i}
diagonal_scalar = 0
for i in range(256):
    bit_i = (matrix_256[i] >> i) & 1
    flipped_bit = 1 - bit_i
    diagonal_scalar |= flipped_bit << i

# Check that the diagonal subset is distinct from all 256 rows
is_distinct = all(diagonal_scalar != row for row in matrix_256)
print("Cantor Diagonal subset distinct from all 256 rows?", is_distinct)

# Map diagonal subset commitment to a public key & SHA-256 seal
diagonal_point = engine.to_affine(
    engine.scalar_mult_projective(diagonal_scalar, engine.B_proj)
)
pk_bytes = engine.encode_point(diagonal_point)
pow_nonce, pow_hash = engine.solve_pow(pk_bytes, difficulty_zeros=4)

print("Diagonal Public Point (Hex):", pk_bytes.hex())
print(f"PoW Seal Nonce: {pow_nonce}, Hash: {pow_hash}")
```

